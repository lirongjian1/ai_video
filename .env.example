APP_ENV=development
APP_NAME=AI Video Workflow
API_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_video
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

STORAGE_PATH=./storage
MAX_UPLOAD_MB=500
AUTO_CREATE_TABLES=false
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend only. Keep this aligned with the backend port.
VITE_API_TARGET=http://127.0.0.1:8010

